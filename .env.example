# Copiar a `.env` en la raíz del repositorio. El archivo `.env` NO se sube a git.

# --- API (apps/api) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Cambiar CLAVE por la contraseña del usuario postgres de tu PostgreSQL local.
DATABASE_URL=postgres://postgres:CLAVE@localhost:5432/hardware_validator
CORS_ORIGIN=http://localhost:5173

# --- Web (apps/web) ---
# true = el navegador usa los datos simulados (MSW) en vez de la API real.
VITE_USE_MOCKS=false
